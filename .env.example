# Solo para el proxy del LLM (server/llm-proxy.mjs). El frontend no necesita nada.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
PORT=8787
# Orígenes permitidos (CORS) separados por comas
ALLOWED_ORIGINS=http://localhost:5173
# Frontend: desbloquea todas las tarjetas en desarrollo (no hay pagos aún)
VITE_DEV_UNLOCK=false
